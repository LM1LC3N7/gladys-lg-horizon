{
  "name": "gladys-lg-horizon",
  "version": "0.1.2",
  "private": true,
  "description": "Gladys Assistant external integration for LG Horizon set-top boxes (Ziggo, Telenet, BASE, Sunrise, Virgin Media, UPC), through the operator cloud (REST and MQTT). Unofficial, not affiliated with LG, Liberty Global or the operators.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-lg-horizon.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
